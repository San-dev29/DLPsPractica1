#
# Quartus II 64-Bit
# Version 13.0.1 Build 232 06/12/2013 Service Pack 1 SJ Web Edition
# Date created = 10:00:00  October 30, 2026
#
# -------------------------------------------------------------------------- #

set_global_assignment -name FAMILY "Cyclone II"
set_global_assignment -name DEVICE EP2C5T144C8
set_global_assignment -name TOP_LEVEL_ENTITY Punto2_Registro
set_global_assignment -name ORIGINAL_QUARTUS_VERSION "13.0 SP1"
set_global_assignment -name PROJECT_CREATION_TIME_DATE "10:00:00  OCTOBER 30, 2026"
set_global_assignment -name LAST_QUARTUS_VERSION "13.0 SP1"
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 85
set_global_assignment -name ERROR_CHECK_FREQUENCY_DIVISOR 1
set_global_assignment -name VHDL_FILE src/Punto2_Registro.vhd
set_global_assignment -name VHDL_FILE src/debounce_btn.vhd
set_global_assignment -name VHDL_FILE src/registro_desplazamiento.vhd
set_global_assignment -name SDC_FILE Punto2_Registro.sdc
set_global_assignment -name STRATIX_DEVICE_IO_STANDARD "3.3-V LVTTL"

# Reloj de la placa (50 MHz)
set_location_assignment PIN_17 -to clk

# DIP switch 1: bit 0 = dato serie, bit 1 = enable (activo alto)
set_location_assignment PIN_120 -to din
set_location_assignment PIN_122 -to enable

# Pulsadores de control (activo alto, pull-down).
# Se usan pines de I/O normales, evitando 73 (defectuoso) y 74/75 (PLL).
set_location_assignment PIN_100 -to btn_clk
set_location_assignment PIN_97 -to btn_rst

# Barra de LEDs 1: una salida por etapa del registro (activo alto)
set_location_assignment PIN_121 -to led[0]
set_location_assignment PIN_125 -to led[1]
set_location_assignment PIN_129 -to led[2]
set_location_assignment PIN_133 -to led[3]
set_location_assignment PIN_135 -to led[4]
set_location_assignment PIN_137 -to led[5]
set_location_assignment PIN_141 -to led[6]
set_location_assignment PIN_143 -to led[7]

# El pin 76 es LVDS41p/nCEO (doble proposito). Se deja liberado como I/O
# normal por si se reutiliza; sin esto el fitter lo reserva como nCEO.
set_global_assignment -name CYCLONEII_RESERVE_NCEO_AFTER_CONFIGURATION "USE AS REGULAR IO"

set_global_assignment -name RESERVE_ALL_UNUSED_PINS "AS INPUT TRI-STATED"
set_global_assignment -name RESERVE_ALL_UNUSED_PINS_NO_OUTPUT_GND "AS INPUT TRI-STATED"
