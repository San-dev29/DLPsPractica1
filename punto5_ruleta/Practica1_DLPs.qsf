set_global_assignment -name FAMILY "Cyclone II"
set_global_assignment -name DEVICE EP2C5T144C8
set_global_assignment -name TOP_LEVEL_ENTITY Practica1_DLPs
set_global_assignment -name ORIGINAL_QUARTUS_VERSION "13.0 SP1"
set_global_assignment -name PROJECT_CREATION_TIME_DATE "18:49:44  OCTOBER 28, 2026"
set_global_assignment -name LAST_QUARTUS_VERSION "13.0 SP1"
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 85
set_global_assignment -name ERROR_CHECK_FREQUENCY_DIVISOR 1
set_global_assignment -name VHDL_FILE src/Practica1_DLPs.vhd
set_global_assignment -name VHDL_FILE src/div_frecuencia.vhd
set_global_assignment -name VHDL_FILE src/antirrebote.vhd
set_global_assignment -name VHDL_FILE src/control_ruleta.vhd
set_global_assignment -name VHDL_FILE src/lfsr8.vhd
set_global_assignment -name VHDL_FILE src/BinSieteseg.vhd
set_global_assignment -name VHDL_FILE src/display_mux.vhd
set_global_assignment -name VHDL_FILE src/ruleta.vhd
set_global_assignment -name VHDL_FILE ../punto2_registro_desplazamiento/src/debounce_btn.vhd
set_global_assignment -name VHDL_FILE ../punto2_registro_desplazamiento/src/registro_desplazamiento.vhd
set_global_assignment -name VHDL_FILE ../punto2_registro_desplazamiento/src/Punto2_Registro.vhd
set_global_assignment -name VHDL_FILE src/Contador_P3.vhd
set_global_assignment -name VHDL_FILE ../punto3_contador/src/contador_ud.vhd
set_global_assignment -name VHDL_FILE ../punto3_contador/src/div_tick.vhd
set_global_assignment -name VHDL_FILE ../punto3_contador/src/dec_7seg.vhd
set_global_assignment -name SDC_FILE Practica1_DLPs.sdc
set_global_assignment -name STRATIX_DEVICE_IO_STANDARD "3.3-V LVTTL"

# Reloj de la placa (50 MHz)
set_location_assignment PIN_17 -to clk
# Pulsador de arranque/parada (pull-up, activo bajo)
set_location_assignment PIN_144 -to btn_n

# Display de 7 segmentos: seg(0)=A ... seg(6)=G (activo alto)
set_location_assignment PIN_96 -to seg[0]
set_location_assignment PIN_94 -to seg[1]
set_location_assignment PIN_93 -to seg[2]
set_location_assignment PIN_92 -to seg[3]
set_location_assignment PIN_87 -to seg[4]
set_location_assignment PIN_86 -to seg[5]
set_location_assignment PIN_79 -to seg[6]

# Seleccion de digitos del display multiplexado (activo alto)
# dig(0)=digito 3 (ruleta), dig(1)=digito 4 (contador P3)
# dig(2)=digito 5 y dig(3)=digito 6 quedan apagados
set_location_assignment PIN_113 -to dig[0]
set_location_assignment PIN_115 -to dig[1]
set_location_assignment PIN_114 -to dig[2]
set_location_assignment PIN_112 -to dig[3]

# LEDs D2, D4, D5 (activo bajo)
set_location_assignment PIN_3 -to led_n[2]
set_location_assignment PIN_7 -to led_n[1]
set_location_assignment PIN_9 -to led_n[0]

# DIP switch 1 (activo alto):
#   bit 0 = dato serie del punto 2, bit 1 = enable del punto 2
#   bit 2 = direccion del punto 3, bit 3 = habilitacion del punto 3
set_location_assignment PIN_120 -to dip1[0]
set_location_assignment PIN_122 -to dip1[1]
set_location_assignment PIN_126 -to dip1[2]
set_location_assignment PIN_132 -to dip1[3]

# Barra de LEDs 1 (activo alto): etapas q(7..0) del registro
set_location_assignment PIN_121 -to bar1[0]
set_location_assignment PIN_125 -to bar1[1]
set_location_assignment PIN_129 -to bar1[2]
set_location_assignment PIN_133 -to bar1[3]
set_location_assignment PIN_135 -to bar1[4]
set_location_assignment PIN_137 -to bar1[5]
set_location_assignment PIN_141 -to bar1[6]
set_location_assignment PIN_143 -to bar1[7]

# El pin 76 es LVDS41p/nCEO (doble proposito). Se deja liberado como I/O
# normal por si se vuelve a usar; sin esto el fitter lo reserva como nCEO.
set_global_assignment -name CYCLONEII_RESERVE_NCEO_AFTER_CONFIGURATION "USE AS REGULAR IO"

# Pulsadores del punto 2 (activo alto, pull-down)
# btn 3 = reloj del registro, btn 4 = reset del registro
set_location_assignment PIN_100 -to btn3
set_location_assignment PIN_97 -to btn4

# Pulsadores del punto 3 (activo alto, pull-down)
# btn 1 = reset del contador, btn 2 = start del contador
# Los pines 74 y 75 son entradas de reloj/PLL; se usan como I/O normal,
# igual que en la antigua prueba de componentes. Revisar los warnings del
# fitter y confirmar en la placa.
set_location_assignment PIN_74 -to btn1
set_location_assignment PIN_75 -to btn2
set_global_assignment -name RESERVE_ALL_UNUSED_PINS "AS INPUT TRI-STATED"

set_global_assignment -name RESERVE_ALL_UNUSED_PINS_NO_OUTPUT_GND "AS INPUT TRI-STATED"
set_global_assignment -name PARTITION_NETLIST_TYPE SOURCE -section_id Top
set_global_assignment -name PARTITION_FITTER_PRESERVATION_LEVEL PLACEMENT_AND_ROUTING -section_id Top
set_global_assignment -name PARTITION_COLOR 16764057 -section_id Top


set_instance_assignment -name PARTITION_HIERARCHY root_partition -to | -section_id Top